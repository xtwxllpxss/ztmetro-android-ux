<?xml version="1.0" encoding="utf-8"?>
<!--
  THROWAWAY RRO used only to test whether android:string/config_recentsComponentName
  can be pointed at the ordinary ztmetro Action Centre package. Do not ship this
  APK or add it to the launcher/action-centre build outputs.

  It is a *dynamic* runtime resource overlay (no code, no permissions). On a
  stock user build it must be installed with `adb install` and enabled with
  `cmd overlay enable` for user 0; ActivityTaskManager
  reads the string once at systemReady, so a reboot is required before the value
  has any effect. See ../README.md for the measured/expected result.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ztmetro.overlay.recents"
    android:versionCode="1"
    android:versionName="1.0-throwaway">

    <overlay
        android:targetPackage="android"
        android:isStatic="false"
        android:priority="1" />

    <application
        android:allowBackup="false"
        android:hasCode="false" />
</manifest>
