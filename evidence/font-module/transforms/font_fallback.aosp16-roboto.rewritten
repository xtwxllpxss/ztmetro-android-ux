<?xml version="1.0" encoding="utf-8"?>
<familyset>
    <family name="sans-serif">
        <!-- ztmetro-font: Selawik 1.01 (SIL OFL 1.1), Segoe UI metric-compatible.
             Static faces; weights are declared per entry, no variable axes.
             Selawik has no italic faces: italic entries use the upright face. -->
        <font weight="100" style="normal">Selawik-Light.ttf</font>
        <font weight="200" style="normal">Selawik-Light.ttf</font>
        <font weight="300" style="normal">Selawik-Light.ttf</font>
        <font weight="350" style="normal">Selawik-Semilight.ttf</font>
        <font weight="400" style="normal">Selawik-Regular.ttf</font>
        <font weight="500" style="normal">Selawik-Semibold.ttf</font>
        <font weight="600" style="normal">Selawik-Semibold.ttf</font>
        <font weight="700" style="normal">Selawik-Bold.ttf</font>
        <font weight="800" style="normal">Selawik-Bold.ttf</font>
        <font weight="900" style="normal">Selawik-Bold.ttf</font>
        <font weight="100" style="italic">Selawik-Light.ttf</font>
        <font weight="200" style="italic">Selawik-Light.ttf</font>
        <font weight="300" style="italic">Selawik-Light.ttf</font>
        <font weight="350" style="italic">Selawik-Semilight.ttf</font>
        <font weight="400" style="italic">Selawik-Regular.ttf</font>
        <font weight="500" style="italic">Selawik-Semibold.ttf</font>
        <font weight="600" style="italic">Selawik-Semibold.ttf</font>
        <font weight="700" style="italic">Selawik-Bold.ttf</font>
        <font weight="800" style="italic">Selawik-Bold.ttf</font>
        <font weight="900" style="italic">Selawik-Bold.ttf</font>
    </family>
  <family name="sans-serif-condensed">
    <font supportedAxes="wght,ital">
      Roboto-Regular.ttf
      <axis tag="wdth" stylevalue="75.0"/>
    </font>
  </family>
  <family name="roboto">
    <font supportedAxes="wght,ital">
      Roboto-Regular.ttf
      <axis tag="wdth" stylevalue="100.0"/>
    </font>
  </family>
  <alias name="arial" to="sans-serif"/>
  <alias name="helvetica" to="sans-serif"/>
  <alias name="sans-serif-black" to="sans-serif" weight="900"/>
  <alias name="sans-serif-light" to="sans-serif" weight="300"/>
  <alias name="sans-serif-medium" to="sans-serif" weight="500"/>
  <alias name="sans-serif-thin" to="sans-serif" weight="100"/>
</familyset>
