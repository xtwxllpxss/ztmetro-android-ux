<?xml version="1.0" encoding="utf-8"?>
<!--
  SystemUI dimensions for the four stock surfaces.

  Both names exist in the SHIPPED SystemUI APK (aapt2 dump resources
  /tmp/sysui.apk, sha256 67e2f10c…):
    0x7f070d6d volume_dialog_background_corner_radius 30dp
    0x7f07035b global_actions_corner_radius            28dp

  Source definitions: packages/SystemUI/res/values/dimens.xml:2238
  (volume_dialog_background_corner_radius 30dp) and :1159
  (global_actions_corner_radius 28dp).

  volume_dialog_background_square_corner_radius (source :2264, 12dp) is
  deliberately NOT shipped: its only consumer is
  drawable/volume_dialog_background_small_radius.xml, which is absent from the
  shipped APK, so the override would be inert.  Report §4 lists it.

  The volume-panel stock VERTICAL SLIDER lives in Compose and reads no dimen
  here (it hard-codes trackCornerSize 12.dp / trackSize 40.dp in
  volume/dialog/sliders/ui/compose/VolumeDialogSliderTrack.kt:58-60), so
  these values square only the View-drawn panel shell, ringer drawer and
  floating capsule; they do not square the Compose slider itself (reported
  as inert in evidence/volume-power-toast/REPORT.md §4).
-->
<resources>
    <dimen name="volume_dialog_background_corner_radius">0dp</dimen>
    <dimen name="global_actions_corner_radius">0dp</dimen>
</resources>
