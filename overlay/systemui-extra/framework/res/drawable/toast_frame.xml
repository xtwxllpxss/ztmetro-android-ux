<?xml version="1.0" encoding="utf-8"?>
<!--
  Framework toast frame: flat black, square.

  Target at lineage-23.2 core/res/res/drawable/toast_frame.xml:18-22:

      <solid android:color="?android:attr/colorBackgroundFloating" />
      <corners android:radius="28dp" />

  Consumers (verified in the shipped SystemUI APK, sha256 67e2f10c…):
  packages/SystemUI/res/layout/text_toast.xml:26 sets
  android:background="@android:drawable/toast_frame" (aapt2 xmltree of the live
  APK shows the framework id 0x01080096), and SystemUIToast.java:174-176
  inflates exactly that layout.  So changing the framework drawable changes
  every SystemUI text toast without a SystemUI layout override.

  #000000 = token color.chrome.action_centre (ztmetro.c:6501-6502);
  radius 0 = token metrics.corner_radius_dp 0.  The 16 dp horizontal padding
  and elevation still come from text_toast.xml.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="0dp" />
    <solid android:color="#FF000000" />
</shape>
