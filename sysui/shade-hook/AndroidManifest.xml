<?xml version="1.0" encoding="utf-8"?>
<!--
  ztMetro shade hook — independent LSPosed module that redirects the stock
  notification shade to the Metro Action Centre on LineageOS 23.2
  (Android 16 / API 36).

  Module container only: no Activity, no Service, no BroadcastReceiver, no
  permissions, no windows of its own.  LSPosed loads classes.dex into the
  com.android.systemui process and reads the xposed* meta-data below.

  xposedminversion 93: the legacy de.robv.android.xposed API level LSPosed's
  module docs require; the code only uses API-82 calls (same convention as the
  working settings-header and keyguard modules).

  xposedscope: android (system_server) + com.android.systemui.
  * android            -> FrameworkHooks: block WindowState#transferTouch() for the
                          status bar window, i.e. stop DisplayPolicy from rerouting
                          a top-edge gesture to SystemUI.  This is what keeps the
                          stock shade from opening at all.
  * com.android.systemui -> ShadeHooks/ShadeRouter: safety net; if a stock shade
                          opened anyway, close it and start the Action Centre.
  Without the "android" scope the APK still works, but only as the late safety
  net (the old v1 behaviour).  The stock shade is never modified in place.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ztmetro.shadehook"
    android:versionCode="2"
    android:versionName="2.0">

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>
</manifest>
