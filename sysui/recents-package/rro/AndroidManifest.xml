<?xml version="1.0" encoding="utf-8"?>
<!--
  ztmetro-recents: static framework RRO that makes the Action Centre the recents
  component. Static (immutable) is deliberate:

  * AOSP RecentTasks.loadRecentsComponent() and PackageManagerService both read
    android:string/config_recentsComponentName during system_server boot, before
    any late_start Magisk service runs. A dynamic RRO enabled by service.sh would
    only take effect on the *next* boot, and Resources.getSystem()-based readers
    need an immutable overlay (same rule the ZtMetroFramework overlay follows).
  * Being static also means no `cmd overlay enable` (CHANGE_OVERLAY_PACKAGES) is
    needed on a user build: the value is in effect on the first boot after the
    module is installed, and rollback is "remove the module, reboot".

  Install path: <module>/system/product/overlay/, which on this phone is
  /product/overlay (the ztmetro-overlays module already ships static framework
  overlays there). config_recentsComponentName is not inside an <overlayable>
  group in framework-res, so no targetName and no platform signature are
  required; the throwaway key generated by the build is enough.

  Resource id on this ROM: 0x010402cb string/config_recentsComponentName
  (see repo/evidence/transitions-recents/framework/recents-evidence.txt).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ztmetro.overlay.recents"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="36" android:targetSdkVersion="36" />

    <overlay
        android:targetPackage="android"
        android:isStatic="true"
        android:priority="3" />

    <application
        android:allowBackup="false"
        android:hasCode="false" />
</manifest>
