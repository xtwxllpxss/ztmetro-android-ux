<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ztmetro.actioncentre"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />

    <!-- CAMERA is the only dangerous permission: it is required by
         CameraManager.setTorchMode() for the flashlight tile. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Special appop (not a runtime dangerous permission): rotation lock and
         the brightness cycle write Settings.System. The user grants it from
         Settings (or `adb shell appops set ... WRITE_SETTINGS allow`). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Normal install-time permissions, no prompt: read Wi-Fi / network state. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional, for the real signal-level bars in the status strip. It is never
         requested at runtime: without a grant the strip still draws four static
         bars. Grant it once with `pm grant org.ztmetro.actioncentre
         android.permission.READ_PHONE_STATE` if real levels are wanted. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Recents prototype: normal permission for moveTaskToFront(taskId). It is
         not enough to remove another app's task (REMOVE_TASKS is
         signature|recents|role); the activity reports that boundary instead of
         faking a dismissal. -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- Recents prototype fallback: lets the user grant Usage Access so the
         frame can show a recently-used app list when the task list is not
         visible. App-op permission, no runtime prompt. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Normal permission, no prompt: KeyguardManager.requestDismissKeyguard()
         is the non-secure unlock path. A secure lock uses the system
         confirm-credential activity instead. -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ActionCentre">

        <activity
            android:name=".ActionCentreActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ActionCentre">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent helper for the lock overlay's unlock path. No UI, no
             window animation, excluded from recents. showWhenLocked makes it the
             top activity while the keyguard is up (our accessibility overlay is
             above it); it dismisses a non-secure keyguard or launches the system
             confirm-credential activity, then finishes. -->
        <activity
            android:name=".UnlockProxyActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ActionCentre.UnlockProxy"
            android:turnScreenOn="false" />

        <!-- ztmetro recents prototype. Deliberately not a LAUNCHER activity:
             it is reached explicitly (am start, a future Start gesture) and it
             must stay out of the task list it is trying to draw. -->
        <activity
            android:name=".RecentsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/recents_title"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Recents">
            <intent-filter>
                <action android:name="org.ztmetro.actioncentre.RECENTS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Tiny tile entry point for the ztmetro Start launcher. It is not a
             second app-drawer icon: Start (or Tasker/Shortcut) can start the
             alias explicitly. Add MAIN/LAUNCHER here if a drawer icon is wanted. -->
        <activity-alias
            android:name=".TileAlias"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_name"
            android:targetActivity=".ActionCentreActivity">
            <intent-filter>
                <action android:name="org.ztmetro.actioncentre.OPEN_TILE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Optional: the user enables this in Settings > Accessibility. The
             system binds it; the app cannot grant it itself. It only watches
             SystemUI window-state events (see res/xml/shade_bridge.xml) and
             replaces the stock shade with this panel. -->
        <service
            android:name=".ShadeBridgeService"
            android:exported="true"
            android:label="@string/shade_bridge_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/shade_bridge" />
        </service>

        <!-- Optional, enabled separately in Settings > Accessibility. Draws the
             28 dp ztMetro status strip (battery, Wi-Fi, signal, clock) as a
             TYPE_ACCESSIBILITY_OVERLAY above the stock status bar. The window is
             NOT_TOUCHABLE; the shade bridge above still receives the top-edge
             gesture. Disabled service = no window, stock bar untouched. -->
        <service
            android:name=".StatusStripService"
            android:exported="true"
            android:label="@string/status_strip_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/status_strip_service" />
        </service>

        <!-- Optional: the user enables this in Settings > Notifications >
             Device & app notifications. The system binds it; the app cannot
             grant it itself. -->
        <service
            android:name=".ActionCentreListener"
            android:exported="true"
            android:label="@string/listener_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
