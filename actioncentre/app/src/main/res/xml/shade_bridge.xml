<?xml version="1.0" encoding="utf-8"?>
<!--
  Accessibility configuration for ShadeBridgeService.

  Window-state events for the shade detector, plus content-changed events for
  the lock overlay (LockOverlayController): the keyguard bouncer and an IME
  appearing over the lock screen arrive as content changes, and the overlay
  must get out of their way at once. Events come from all packages: the previous
  foreground package is needed to tell a shade that opens over a third-party app
  from one that opens over our own panel, and a foreign app window while locked
  (call, alarm, camera) must take the lock overlay away. The service reads only
  window packages/titles/bounds, never view text. flagRetrieveInteractiveWindows
  is the actual detector: the expanded shade is the SystemUI window whose bounds
  cover the screen, the status bar is the small one. flagReportViewIds is
  requested per spec (no view ids are read). canRetrieveWindowContent is
  required by getWindows().getRoot() for the window package.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/shade_bridge_description"
    android:notificationTimeout="100" />
