<?xml version="1.0" encoding="utf-8"?>
<!-- ztMetro page header, inflated from the MODULE's own APK resources.
     Reference: evidence/ux-compare/refs/ztos-about.png / ztos-networking.png —
     an ALL-CAPS label above a huge lowercase page title on flat black.
     Every colour/size below is a generated resource (tools/gen_header_res.py). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/metro_header"
    android:tag="ztmetro_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/metro_header_height"
    android:background="@drawable/metro_header_bg"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingStart="@dimen/metro_header_padding_h"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/metro_header_padding_h"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/metro_header_label"
        android:tag="ztmetro_header_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/metro_header_label"
        style="@style/MetroHeaderLabel" />

    <TextView
        android:id="@+id/metro_header_title"
        android:tag="ztmetro_header_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metro_header_label_to_title"
        style="@style/MetroHeaderTitle" />
</LinearLayout>
