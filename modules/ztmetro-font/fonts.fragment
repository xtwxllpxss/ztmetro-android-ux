    <family name="sans-serif">
        <!-- ztmetro-font: Open Sans 3.003 (SIL OFL 1.1), Segoe UI-class humanist sans.
             Static faces with real italics; weights are declared per entry, no
             variable axes. Open Sans has full Cyrillic and Greek, so Russian and
             English UI text share one family (Selawik 1.01 had no Cyrillic).
             350 has no Open Sans face: it maps to Light, matching the token policy
             that sends semilight/350 to sans-serif-light/300. -->
        <font weight="100" style="normal">OpenSans-Light.ttf</font>
        <font weight="200" style="normal">OpenSans-Light.ttf</font>
        <font weight="300" style="normal">OpenSans-Light.ttf</font>
        <font weight="350" style="normal">OpenSans-Light.ttf</font>
        <font weight="400" style="normal">OpenSans-Regular.ttf</font>
        <font weight="500" style="normal">OpenSans-SemiBold.ttf</font>
        <font weight="600" style="normal">OpenSans-SemiBold.ttf</font>
        <font weight="700" style="normal">OpenSans-Bold.ttf</font>
        <font weight="800" style="normal">OpenSans-Bold.ttf</font>
        <font weight="900" style="normal">OpenSans-Bold.ttf</font>
        <font weight="100" style="italic">OpenSans-LightItalic.ttf</font>
        <font weight="200" style="italic">OpenSans-LightItalic.ttf</font>
        <font weight="300" style="italic">OpenSans-LightItalic.ttf</font>
        <font weight="350" style="italic">OpenSans-LightItalic.ttf</font>
        <font weight="400" style="italic">OpenSans-Italic.ttf</font>
        <font weight="500" style="italic">OpenSans-SemiBoldItalic.ttf</font>
        <font weight="600" style="italic">OpenSans-SemiBoldItalic.ttf</font>
        <font weight="700" style="italic">OpenSans-BoldItalic.ttf</font>
        <font weight="800" style="italic">OpenSans-BoldItalic.ttf</font>
        <font weight="900" style="italic">OpenSans-BoldItalic.ttf</font>
    </family>
